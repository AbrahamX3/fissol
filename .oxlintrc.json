{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": [
		"react",
		"react-perf",
		"nextjs",
		"import",
		"typescript",
		"oxc",
		"unicorn"
	],
	"rules": {
		"react-hooks/rules-of-hooks": "error",
		"react-hooks/exhaustive-deps": "warn"
	},
	"ignorePatterns": [
		"node_modules",
		".next",
		"dist",
		"build",
		"*.config.js",
		"*.config.ts",
		"*.config.mjs"
	]
}
